{
  "name": "mynsweepr-vue",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "yarn exec vue-cli-service serve",
    "lint": "yarn exec vue-cli-service lint",
    "update:yarn": "yarn set version latest && yarn dlx npm-check-updates -u && yarn install",
    "update:browserslist": "yarn dlx -p browserslist -p update-browserslist-db update-browserslist-db",
    "build": "yarn exec vue-cli-service build",
    "build:deploy:fs": "rm -r ../publish/mynsweepr-vue/ && cp -r dist/ ../publish/mynsweepr-vue/",
    "build:deploy": "yarn run update:yarn && yarn run update:browserslist && yarn run build && yarn run build:deploy:fs"
  },
  "dependencies": {
    "ansi-regex": "^6.5.0",
    "core-js": "^3.51.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "glob-parent": "^6.0.2",
    "serialize-javascript": "^7.1.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/helper-compilation-targets": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@vue/babel-plugin-jsx": "^3.0.0",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-router": "^5.0.9",
    "@vue/cli-plugin-vuex": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "@vue/compiler-sfc": "^3.5.44",
    "browserslist": "^4.29.5",
    "update-browserslist-db": "^1.3.4",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "ansi-regex": "ansi-regex$",
    "glob-parent": "glob-parent$"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "eslintConfig": {
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/strongly-recommended",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "root": true
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "packageManager": "yarn@4.18.1"
}
